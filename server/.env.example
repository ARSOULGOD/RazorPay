# Environment template for AI Finance Controller server
# Copy to .env and fill in with real credentials

# PostgreSQL connection string (must match docker-compose setup)
DATABASE_URL="postgresql://aifc_user:aifc_dev_pw@localhost:5432/ai_finance_controller?schema=public"

# Connection pool limit (default 10). API returns 503 if exhausted.
# For production, use PgBouncer or similar connection pooling proxy.
DB_CONNECTION_LIMIT=10

# Gemini API (fallover provider)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-latest"
# Tier-2 parallel LLM calls (default 10). Target: ~1 min for ~67 candidates.
LLM_CONCURRENCY=10
# Legacy alias — used only if LLM_CONCURRENCY is unset
# GEMINI_CONCURRENCY=1

# Groq API (primary provider)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Optional: override CORS origin (default: http://localhost:5173 for Vite dev)
# CORS_ORIGIN="http://localhost:5173"

# Optional: override API port (default: 3001)
# PORT=3001
